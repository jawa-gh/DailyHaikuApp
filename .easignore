# .easignore — controls what EAS Build uploads.
#
# When this file exists, EAS CLI uses it INSTEAD of .gitignore to decide which
# files to include in the build. We mirror .gitignore here EXCEPT we do NOT
# exclude the Firebase/RevenueCat config files: those are gitignored so they
# stay out of the PUBLIC GitHub repo, but EAS Build genuinely needs them at
# build time (native config + bundled JS + env). Keeping them here means they
# upload to the build servers without ever being committed to git.
#
# Files intentionally NOT listed below (so they DO upload to EAS):
#   google-services.json        — Android native Firebase config (app.json)
#   GoogleService-Info.plist     — iOS native Firebase config (app.json)
#   firebaseConfig.js            — imported by lib/firebase.ts, bundled by Metro
#   .env                         — EXPO_PUBLIC_* (RevenueCat keys, App Check token)

# dependencies (root + any nested package, e.g. functions/)
**/node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (regenerated by EAS prebuild via CNG)
ios/
android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Local build artifacts
*.ipa
*.apk
*.aab

# Metro
.metro-health-check*

# Firebase Cloud Functions — not needed for the app build
functions/
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# Firebase Admin service account keys — must never leave the machine
*-firebase-adminsdk-*.json
serviceAccountKey*.json

# Firebase project alias mapping — only used by `firebase deploy`, not the app build
.firebaserc

# Functions runtime config
.runtimeconfig.json
functions/.runtimeconfig.json

# Store screenshots — not needed for the build, keeps the upload lean
docs/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env overrides (base .env IS uploaded — see header)
.env*.local

# local markdown notes / secrets (CLAUDE.local.md, SETUP.local.md)
*.local.md

# typescript
*.tsbuildinfo
.vercel

# IDE
.vscode/
.idea/

# Claude Code local config
.claude/

core
