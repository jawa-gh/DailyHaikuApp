# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Variables prefixed with EXPO_PUBLIC_ are inlined into the JS bundle at build
# time and are visible to anyone who decompiles the app. Only put non-secret
# values here. Real secrets (like OpenAI keys) live in Firebase Secret Manager
# and are read by the Cloud Functions in `functions/`.

# Set to "true" to point the app at the local Functions emulator on
# localhost:5001 (10.0.2.2 on Android emulator). Otherwise calls go to the
# deployed europe-west3 functions.
# EXPO_PUBLIC_USE_FUNCTIONS_EMULATOR=true

# App Check debug token for local dev. Generate a UUID (any standard v4 UUID
# works), set it here, and register the same UUID in Firebase Console →
# App Check → your app → ⋮ → Manage debug tokens. Only used in __DEV__ builds;
# production builds use App Attest / Play Integrity.
# EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=00000000-0000-0000-0000-000000000000

# Kill switch to bypass App Check entirely on the client during debugging.
# Function-side enforceAppCheck must also be false or calls will be rejected.
# EXPO_PUBLIC_DISABLE_APP_CHECK=true

# RevenueCat *public* SDK keys, one per platform. These are designed to be
# embedded in the app — not secrets. Use sandbox `test_*` keys here for local
# dev, and set production `appl_*` (iOS) and `goog_*` (Android) keys as EAS
# secrets / eas.json env for production builds.
# Dashboard: https://app.revenuecat.com/projects/<your project>/api-keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
