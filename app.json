{
  "expo": {
    "name": "Daily Haiku Alerts",
    "slug": "daily-haiku-alerts",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daily-haiku",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1923"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jawsharp.dailyhaiku",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "icon": "./assets/images/icon.png",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#0F1923"
      },
      "package": "com.jawsharp.dailyhaiku",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://dailyhaiku.app/"
        }
      ],
      [
        "@react-native-google-signin/google-signin"
      ],
      [
        "expo-font"
      ],
      [
        "expo-web-browser"
      ],
      [
        "expo-apple-authentication"
      ],
      [
        "@react-native-firebase/app"
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#D4A355"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Daily Haiku does not read your photos — this permission only allows saving haiku artwork to your library.",
          "savePhotosPermission": "Allow Daily Haiku to save haiku artwork to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "./plugins/with-modular-headers"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://dailyhaiku.app/"
      },
      "eas": {
        "projectId": "2dee6f10-a783-48b1-ac4f-02167e1c9af7"
      }
    }
  }
}
